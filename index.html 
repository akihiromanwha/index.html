<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Amaze Go</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%;overflow:hidden;background:#05070f;color:#dbe7ff;
    font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
    -webkit-user-select:none;user-select:none;touch-action:none;
    -webkit-tap-highlight-color:transparent}
  #game{position:fixed;inset:0;display:block}

  #hud{position:fixed;top:0;left:0;right:0;padding:14px 16px;display:flex;gap:10px;
    align-items:center;pointer-events:none;font-size:12px;letter-spacing:.09em;
    text-transform:uppercase;flex-wrap:wrap}
  .chip{background:rgba(15,26,52,.72);border:1px solid rgba(90,150,255,.22);
    border-radius:10px;padding:7px 12px;display:flex;gap:7px;align-items:center;
    backdrop-filter:blur(8px)}
  .chip b{color:#7ce7ff;font-weight:600;min-width:1ch}
  .spacer{flex:1}

  #overlay{position:fixed;inset:0;display:grid;place-items:center;z-index:10;
    background:radial-gradient(circle at 50% 40%,rgba(10,20,45,.86),rgba(3,5,12,.97));
    backdrop-filter:blur(6px);transition:opacity .25s}
  #overlay.hide{opacity:0;pointer-events:none}
  .panel{text-align:center;max-width:520px;width:calc(100% - 40px);padding:34px 28px;
    border-radius:20px;border:1px solid rgba(90,150,255,.2);background:rgba(10,18,38,.72);
    box-shadow:0 0 70px rgba(40,120,255,.18)}
  h1{font-size:clamp(26px,7vw,44px);letter-spacing:.14em;margin-bottom:12px;
    background:linear-gradient(90deg,#7ce7ff,#a78bfa,#f472b6);
    -webkit-background-clip:text;background-clip:text;color:transparent}
  p{font-size:14px;line-height:1.75;color:#93a7cc;margin-bottom:20px}
  p b{color:#dbe7ff}
  button{font:inherit;font-size:13px;letter-spacing:.13em;text-transform:uppercase;
    padding:14px 30px;border-radius:12px;border:1px solid rgba(120,200,255,.5);
    background:linear-gradient(180deg,rgba(60,130,255,.35),rgba(40,90,200,.18));
    color:#dff0ff;cursor:pointer;transition:.18s}
  button:hover{background:linear-gradient(180deg,rgba(90,170,255,.55),rgba(60,120,240,.3));
    box-shadow:0 0 30px rgba(80,160,255,.45);transform:translateY(-1px)}
  button:active{transform:translateY(0)}
  .keys{margin-top:18px;font-size:11px;color:#5f739c;letter-spacing:.1em;line-height:1.8}
</style>
</head>
<body>
<canvas id="game"></canvas>

<div id="hud">
  <div class="chip">Nivel <b id="hud-level">1</b></div>
  <div class="chip">★ <b id="hud-stars">0/0</b></div>
  <div class="chip">⏱ <b id="hud-time">0.0</b></div>
  <div class="spacer"></div>
  <div class="chip">Récord <b id="hud-best">--</b></div>
</div>

<div id="overlay"></div>

<script>
(() => {
'use strict';

/* ─────────── Setup ─────────── */
const cvs = document.getElementById('game');
const ctx = cvs.getContext('2d');
const $ = s => document.querySelector(s);

let W = 0, H = 0, DPR = 1;

const TILE      = 64;            // tamaño de celda en unidades de mundo
const PLAYER_R  = TILE * 0.29;
const MAX_SPEED = TILE * 6.2;

const G = {
  level: 1, tw: 0, th: 0, grid: null,
  zoom: 1, cam: { x: 0, y: 0 },
  px: 0, py: 0, vx: 0, vy: 0, trail: [],
  stars: [], starsTotal: 0, starsGot: 0,
  portal: { x: 0, y: 0, active: false },
  particles: [],
  time: 0, playing: false, done: false, shake: 0, t: 0
};

/* ─────────── Utilidades ─────────── */
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;

function fmt(t) {
  if (!isFinite(t) || t < 0) return '--';
  const m = Math.floor(t / 60);
  const s = t - m * 60;
  return m > 0 ? `${m}:${s.toFixed(1).padStart(4, '0')}` : s.toFixed(1);
}

/* ─────────── Generación del laberinto ─────────── */
function generateMaze(cols, rows, braid) {
  const tw = cols * 2 + 1, th = rows * 2 + 1;
  const g = new Uint8Array(tw * th).fill(1);
  const idx = (x, y) => y * tw + x;
  const dirs = [[0, -1], [1, 0], [0, 1], [-1, 0]];

  const visited = new Uint8Array(cols * rows);
  const stack = [[0, 0]];
  visited[0] = 1;
  g[idx(1, 1)] = 0;

  while (stack.length) {
    const [cx, cy] = stack[stack.length - 1];
    const cand = [];
    for (const [dx, dy] of dirs) {
      const nx = cx + dx, ny = cy + dy;
      if (nx >= 0 && nx < cols && ny >= 0 && ny < rows && !visited[ny * cols + nx])
        cand.push([nx, ny, dx, dy]);
    }
    if (!cand.length) { stack.pop(); continue; }
    const [nx, ny, dx, dy] = cand[(Math.random() * cand.length) | 0];
    visited[ny * cols + nx] = 1;
    g[idx(1 + cx * 2 + dx, 1 + cy * 2 + dy)] = 0;
    g[idx(1 + nx * 2, 1 + ny * 2)] = 0;
    stack.push([nx, ny]);
  }

  // "Braid": abre algunos callejones sin salida → laberintos con bucles
  for (let cy = 0; cy < rows; cy++) {
    for (let cx = 0; cx < cols; cx++) {
      if (Math.random() > braid) continue;
      const tx = 1 + cx * 2, ty = 1 + cy * 2;
      let open = 0;
      const walls = [];
      for (const [dx, dy] of dirs) {
        if (g[idx(tx + dx, ty + dy)] === 0) open++;
        else walls.push([dx, dy]);
      }
      if (open !== 1) continue;
      const valid = walls.filter(([dx, dy]) => {
        const nx = cx + dx, ny = cy + dy;
        return nx >= 0 && nx < cols && ny >= 0 && ny < rows;
      });
      if (valid.length) {
        const [dx, dy] = valid[(Math.random() * valid.length) | 0];
        g[idx(tx + dx, ty + dy)] = 0;
      }
    }
  }
  return { grid: g, tw, th };
}

function bfsDist(grid, tw, th, sx, sy) {
  const dist = new Int32Array(tw * th).fill(-1);
  const q = [sy * tw + sx];
  dist[sy * tw + sx] = 0;
  let head = 0;
  while (head < q.length) {
    const cur = q[head++];
    const x = cur % tw, y = (cur / tw) | 0, d = dist[cur];
    const nbs = [[x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]];
    for (const [nx, ny] of nbs) {
      if (nx < 0 || ny < 0 || nx >= tw || ny >= th) continue;
      const ni = ny * tw + nx;
      if (grid[ni] !== 0 || dist[ni] !== -1) continue;
      dist[ni] = d + 1;
      q.push(ni);
    }
  }
  return dist;
}

/* ─────────── Nivel ─────────── */
function startLevel(level) {
  G.level = level;
  const cols = Math.min(6 + Math.floor((level - 1) * 1.4), 20);
  const rows = cols;
  const braid = Math.min(0.10 + level * 0.05, 0.55);

  const m = generateMaze(cols, rows, braid);
  G.grid = m.grid; G.tw = m.tw; G.th = m.th;

  const dist = bfsDist(G.grid, G.tw, G.th, 1, 1);

  // Portal en la celda más lejana
  let bestI = 0, bestD = -1;
  for (let i = 0; i < dist.length; i++) {
    if (dist[i] > bestD) { bestD = dist[i]; bestI = i; }
  }
  const pTx = bestI % G.tw, pTy = (bestI / G.tw) | 0;
  G.portal = { x: (pTx + 0.5) * TILE, y: (pTy + 0.5) * TILE, active: false };

  // Estrellas en celdas suficientemente lejos del inicio
  const minD = Math.max(3, Math.floor(bestD * 0.35));
  const cands = [];
  for (let i = 0; i < dist.length; i++) {
    if (dist[i] >= minD && i !== bestI) cands.push(i);
  }
  for (let i = cands.length - 1; i > 0; i--) {
    const j = (Math.random() * (i + 1)) | 0;
    const tmp = cands[i]; cands[i] = cands[j]; cands[j] = tmp;
  }
  const count = Math.min(3 + Math.floor(level * 0.8), 10);
  G.stars = cands.slice(0, count).map(i => ({
    x: ((i % G.tw) + 0.5) * TILE,
    y: (((i / G.tw) | 0) + 0.5) * TILE,
    got: false,
    ph: Math.random() * 6.283
  }));
  G.starsTotal = G.stars.length;
  G.starsGot = 0;

  // Jugador
  G.px = 1.5 * TILE; G.py = 1.5 * TILE;
  G.vx = 0; G.vy = 0; G.trail = [];
  G.particles = [];
  G.time = 0; G.shake = 0;
  G.playing = true; G.done = false;

  computeZoom();
  G.cam.x = G.px; G.cam.y = G.py;
  clampCam(true);
  updateHUD();
}

/* ─────────── Cámara / zoom ─────────── */
function computeZoom() {
  const mw = G.tw * TILE, mh = G.th * TILE;
  G.zoom = Math.max(0.26, Math.min(W / (mw + 140), H / (mh + 140), 1));
}

function clampCam(snap) {
  const mw = G.tw * TILE, mh = G.th * TILE;
  const vw = W / G.zoom, vh = H / G.zoom;
  const tx = mw <= vw ? mw / 2 : clamp(G.px, vw / 2, mw - vw / 2);
  const ty = mh <= vh ? mh / 2 : clamp(G.py, vh / 2, mh - vh / 2);
  if (snap) { G.cam.x = tx; G.cam.y = ty; }
  else {
    const k = 0.14;
    G.cam.x += (tx - G.cam.x) * k;
    G.cam.y += (ty - G.cam.y) * k;
  }
}

/* ─────────── Colisiones ─────────── */
function isWall(tx, ty) {
  if (tx < 0 || ty < 0 || tx >= G.tw || ty >= G.th) return true;
  return G.grid[ty * G.tw + tx] === 1;
}

function collide(px, py, r) {
  for (let iter = 0; iter < 2; iter++) {
    const minTx = Math.floor((px - r) / TILE), maxTx = Math.floor((px + r) / TILE);
    const minTy = Math.floor((py - r) / TILE), maxTy = Math.floor((py + r) / TILE);
    for (let ty = minTy; ty <= maxTy; ty++) {
      for (let tx = minTx; tx <= maxTx; tx++) {
        if (!isWall(tx, ty)) continue;
        const cx = tx * TILE, cy = ty * TILE;
        const nx = Math.max(cx, Math.min(px, cx + TILE));
        const ny = Math.max(cy, Math.min(py, cy + TILE));
        const dx = px - nx, dy = py - ny;
        const d2 = dx * dx + dy * dy;
        if (d2 >= r * r) continue;
        if (d2 > 1e-6) {
          const d = Math.sqrt(d2);
          const push = r - d;
          px += (dx / d) * push;
          py += (dy / d) * push;
        } else {
          const l = px - cx, rr = cx + TILE - px, t = py - cy, b = cy + TILE - py;
          const mm = Math.min(l, rr, t, b);
          if (mm === l) px = cx - r;
          else if (mm === rr) px = cx + TILE + r;
          else if (mm === t) py = cy - r;
          else py = cy + TILE + r;
        }
      }
    }
  }
  return [px, py];
}

/* ─────────── Entrada ─────────── */
const keys = new Set();
const joy = { active: false, ox: 0, oy: 0, x: 0, y: 0 };
let joyId = null;

addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', ' '].includes(k)) e.preventDefault();
  keys.add(k);
  if (k === 'r' && !overlayVisible()) startLevel(G.level);
});
addEventListener('keyup', e => keys.delete(e.key.toLowerCase()));
addEventListener('blur', () => keys.clear());

cvs.addEventListener('pointerdown', e => {
  if (joyId !== null) return;
  joyId = e.pointerId;
  joy.active = true;
  joy.ox = e.clientX; joy.oy = e.clientY;
  joy.x = 0; joy.y = 0;
  try { cvs.setPointerCapture(e.pointerId); } catch (_) {}
});

cvs.addEventListener('pointermove', e => {
  if (e.pointerId !== joyId) return;
  const dx = e.clientX - joy.ox, dy = e.clientY - joy.oy;
  const d = Math.hypot(dx, dy) || 1;
  const R = 58;
  const mag = Math.min(d, R) / R;
  joy.x = (dx / d) * mag;
  joy.y = (dy / d) * mag;
});

function endPointer(e) {
  if (e.pointerId !== joyId) return;
  joyId = null; joy.active = false; joy.x = 0; joy.y = 0;
}
cvs.addEventListener('pointerup', endPointer);
cvs.addEventListener('pointercancel', endPointer);

function inputVec() {
  let ix = 0, iy = 0;
  if (keys.has('arrowleft') || keys.has('a')) ix--;
  if (keys.has('arrowright') || keys.has('d')) ix++;
  if (keys.has('arrowup') || keys.has('w')) iy--;
  if (keys.has('arrowdown') || keys.has('s')) iy++;
  if (joy.active) { ix = joy.x; iy = joy.y; }
  const m = Math.hypot(ix, iy);
  if (m > 1) { ix /= m; iy /= m; }
  return [ix, iy];
}

/* ─────────── Partículas ─────────── */
function burst(x, y, color, n) {
  for (let i = 0; i < n; i++) {
    const a = Math.random() * Math.PI * 2;
    const sp = 40 + Math.random() * 200;
    G.particles.push({
      x, y,
      vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
      life: 1, color, r: 1.5 + Math.random() * 3
    });
  }
}

function updateParticles(dt) {
  for (let i = G.particles.length - 1; i >= 0; i--) {
    const p = G.particles[i];
    p.x += p.vx * dt; p.y += p.vy * dt;
    p.vx *= 0.93; p.vy *= 0.93;
    p.life -= dt * 1.7;
    if (p.life <= 0) G.particles.splice(i, 1);
  }
}

/* ─────────── Update ─────────── */
let hudAcc = 0;

function update(dt) {
  G.t += dt;
  updateParticles(dt);
  if (G.shake > 0) G.shake = Math.max(0, G.shake - dt * 30);

  if (!G.playing || G.done) return;

  G.time += dt;

  const [ix, iy] = inputVec();
  const tvx = ix * MAX_SPEED, tvy = iy * MAX_SPEED;
  const k = 1 - Math.pow(0.0001, dt);
  G.vx += (tvx - G.vx) * k;
  G.vy += (tvy - G.vy) * k;

  const ox = G.px, oy = G.py;
  G.px += G.vx * dt;
  G.py += G.vy * dt;

  const [nx, ny] = collide(G.px, G.py, PLAYER_R);
  if (Math.abs(nx - G.px) > 0.01) G.vx *= 0.15;
  if (Math.abs(ny - G.py) > 0.01) G.vy *= 0.15;
  G.px = nx; G.py = ny;

  // Rastro
  if (Math.hypot(G.px - ox, G.py - oy) > 0.5) {
    G.trail.push({ x: G.px, y: G.py });
    if (G.trail.length > 16) G.trail.shift();
  }

  // Estrellas
  for (const s of G.stars) {
    if (s.got) continue;
    if (Math.hypot(s.x - G.px, s.y - G.py) < PLAYER_R + TILE * 0.24) {
      s.got = true;
      G.starsGot++;
      burst(s.x, s.y, '#ffd66b', 20);
      G.shake = Math.min(G.shake + 3, 8);
      if (G.starsGot === G.starsTotal) {
        G.portal.active = true;
        burst(G.portal.x, G.portal.y, '#7ce7ff', 36);
      }
      updateHUD();
    }
  }

  // Portal
  if (G.portal.active &&
      Math.hypot(G.portal.x - G.px, G.portal.y - G.py) < PLAYER_R + TILE * 0.34) {
    completeLevel();
  }

  clampCam(false);

  hudAcc += dt;
  if (hudAcc > 0.08) { hudAcc = 0; updateHUD(); }
}

/* ─────────── Render ─────────── */
function drawMaze() {
  const { grid, tw, th } = G;
  const mw = tw * TILE, mh = th * TILE;

  ctx.fillStyle = '#070c1a';
  ctx.fillRect(0, 0, mw, mh);

  const vw = W / G.zoom, vh = H / G.zoom;
  const x0 = Math.max(0, Math.floor((G.cam.x - vw / 2) / TILE) - 1);
  const x1 = Math.min(tw - 1, Math.ceil((G.cam.x + vw / 2) / TILE) + 1);
  const y0 = Math.max(0, Math.floor((G.cam.y - vh / 2) / TILE) - 1);
  const y1 = Math.min(th - 1, Math.ceil((G.cam.y + vh / 2) / TILE) + 1);

  const path = new Path2D();
  for (let y = y0; y <= y1; y++) {
    for (let x = x0; x <= x1; x++) {
      if (grid[y * tw + x]) path.rect(x * TILE, y * TILE, TILE, TILE);
    }
  }
  ctx.fillStyle = '#0f1a34';
  ctx.fill(path);
  ctx.strokeStyle = 'rgba(96,160,255,0.14)';
  ctx.lineWidth = 1.5;
  ctx.stroke(path);
}

function drawPortal() {
  const p = G.portal, t = G.t;
  const r = TILE * 0.34;
  const active = p.active;
  const glow = active ? '#7ce7ff' : '#3b4a6b';

  ctx.save();
  ctx.translate(p.x, p.y);
  ctx.rotate(t * 1.1);
  ctx.shadowBlur = active ? 28 : 8;
  ctx.shadowColor = glow;
  ctx.strokeStyle = glow;
  ctx.lineWidth = 4;
  ctx.lineCap = 'round';
  for (let i = 0; i < 3; i++) {
    const a = (i * Math.PI * 2) / 3;
    ctx.beginPath();
    ctx.arc(0, 0, r, a, a + Math.PI * 0.55);
    ctx.stroke();
  }
  ctx.restore();

  const pulse = 0.6 + 0.4 * Math.sin(t * 3);
  ctx.save();
  ctx.shadowBlur = active ? 26 : 0;
  ctx.shadowColor = '#7ce7ff';
  ctx.beginPath();
  ctx.arc(p.x, p.y, r * 0.5 * pulse, 0, Math.PI * 2);
  ctx.fillStyle = active ? 'rgba(124,231,255,0.9)' : 'rgba(70,90,140,0.45)';
  ctx.fill();
  ctx.restore();
}

function drawStars() {
  for (const s of G.stars) {
    if (s.got) continue;
    const pulse = 0.75 + 0.25 * Math.sin(G.t * 4 + s.ph);
    const r = TILE * 0.15 * pulse;

    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.shadowBlur = 18;
    ctx.shadowColor = '#ffd66b';
    ctx.fillStyle = '#ffe89a';
    ctx.beginPath();
    for (let i = 0; i < 4; i++) {
      const a = (i * Math.PI) / 2 + G.t * 0.8;
      ctx.lineTo(Math.cos(a) * r * 2.0, Math.sin(a) * r * 2.0);
      const a2 = a + Math.PI / 4;
      ctx.lineTo(Math.cos(a2) * r * 0.7, Math.sin(a2) * r * 0.7);
    }
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }
}

function drawTrail() {
  const n = G.trail.length;
  for (let i = 0; i < n; i++) {
    const p = G.trail[i];
    const f = (i + 1) / n;
    ctx.beginPath();
    ctx.arc(p.x, p.y, PLAYER_R * (0.25 + 0.6 * f), 0, Math.PI * 2);
    ctx.fillStyle = `rgba(124,231,255,${0.28 * f * f})`;
    ctx.fill();
  }
}

function drawPlayer() {
  ctx.save();
  ctx.shadowBlur = 30;
  ctx.shadowColor = '#54d6ff';
  const g = ctx.createRadialGradient(G.px, G.py, 0, G.px, G.py, PLAYER_R * 1.7);
  g.addColorStop(0, '#ffffff');
  g.addColorStop(0.35, '#9df0ff');
  g.addColorStop(0.7, 'rgba(84,214,255,0.55)');
  g.addColorStop(1, 'rgba(60,140,255,0)');
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(G.px, G.py, PLAYER_R * 1.7, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

function drawParticles() {
  for (const p of G.particles) {
    ctx.globalAlpha = Math.max(0, p.life);
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r * p.life, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}

function drawFog() {
  const px = (G.px - G.cam.x) * G.zoom + W / 2;
  const py = (G.py - G.cam.y) * G.zoom + H / 2;
  const R = Math.max(6 * TILE * G.zoom, Math.min(W, H) * 0.5);
  const g = ctx.createRadialGradient(px, py, 0, px, py, R);
  g.addColorStop(0, 'rgba(3,6,15,0)');
  g.addColorStop(0.45, 'rgba(3,6,15,0.10)');
  g.addColorStop(0.75, 'rgba(3,6,15,0.52)');
  g.addColorStop(1, 'rgba(3,6,15,0.90)');
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, W, H);
}

function drawJoystick() {
  if (!joy.active) return;
  ctx.save();
  ctx.globalAlpha = 0.55;
  ctx.strokeStyle = 'rgba(124,231,255,0.7)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(joy.ox, joy.oy, 58, 0, Math.PI * 2);
  ctx.stroke();
  ctx.beginPath();
  ctx.arc(joy.ox + joy.x * 58, joy.oy + joy.y * 58, 24, 0, Math.PI * 2);
  ctx.fillStyle = 'rgba(124,231,255,0.35)';
  ctx.fill();
  ctx.restore();
}

function draw() {
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

  const bg = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, Math.max(W, H) * 0.8);
  bg.addColorStop(0, '#0a1226');
  bg.addColorStop(1, '#04060e');
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  ctx.save();
  let sx = 0, sy = 0;
  if (G.shake > 0.1) {
    sx = (Math.random() - 0.5) * G.shake;
    sy = (Math.random() - 0.5) * G.shake;
  }
  ctx.translate(W / 2 + sx, H / 2 + sy);
  ctx.scale(G.zoom, G.zoom);
  ctx.translate(-G.cam.x, -G.cam.y);

  drawMaze();
  drawPortal();
  drawStars();
  drawTrail();
  drawPlayer();
  drawParticles();

  ctx.restore();

  drawFog();
  drawJoystick();
}

/* ─────────── HUD y overlays ─────────── */
function updateHUD() {
  $('#hud-level').textContent = G.level;
  $('#hud-stars').textContent = `${G.starsGot}/${G.starsTotal}`;
  $('#hud-time').textContent = fmt(G.time);
  const best = localStorage.getItem('amazego.best.' + G.level);
  $('#hud-best').textContent = best ? fmt(parseFloat(best)) : '--';
}

const ov = $('#overlay');
function showOverlay(html) {
  ov.innerHTML = `<div class="panel">${html}</div>`;
  ov.classList.remove('hide');
}
function hideOverlay() { ov.classList.add('hide'); }
function overlayVisible() { return !ov.classList.contains('hide'); }

function completeLevel() {
  G.done = true;
  G.playing = false;
  burst(G.portal.x, G.portal.y, '#7ce7ff', 60);
  G.shake = 14;

  const key = 'amazego.best.' + G.level;
  const prev = parseFloat(localStorage.getItem(key) || '0');
  const record = !prev || G.time < prev;
  if (record) localStorage.setItem(key, String(G.time));
  updateHUD();

  showOverlay(`
    <h1>Nivel ${G.level}</h1>
    <p>${record ? '🏆 ¡Nuevo récord!' : 'Completado'}<br>
       Tiempo: <b>${fmt(G.time)}</b>${prev && !record ? ` · Récord: <b>${fmt(prev)}</b>` : ''}</p>
    <button id="btn-next">Siguiente nivel →</button>
  `);
  $('#btn-next').onclick = () => { hideOverlay(); startLevel(G.level + 1); };
}

function showStart() {
  showOverlay(`
    <h1>AMAZE GO</h1>
    <p>Guía la chispa por el laberinto, recoge todas las
       <b style="color:#ffd66b">estrellas</b> y escapa por el
       <b style="color:#7ce7ff">portal</b>.<br>
       Cada nivel es más grande… y más retorcido.</p>
    <button id="btn-start">Jugar</button>
    <div class="keys">WASD / Flechas · R reinicia · Arrastra en móvil</div>
  `);
  $('#btn-start').onclick = () => { hideOverlay(); startLevel(1); };
}

/* ─────────── Resize y bucle ─────────── */
function resize() {
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth;
  H = window.innerHeight;
  cvs.width = Math.round(W * DPR);
  cvs.height = Math.round(H * DPR);
  cvs.style.width = W + 'px';
  cvs.style.height = H + 'px';
  if (G.grid) { computeZoom(); clampCam(true); }
}
addEventListener('resize', resize);

let last = performance.now();
function loop(now) {
  let dt = (now - last) / 1000;
  last = now;
  if (dt > 0.05) dt = 0.05;
  update(dt);
  draw();
  requestAnimationFrame(loop);
}

/* ─────────── Arranque ─────────── */
resize();
G.tw = 13; G.th = 13; G.grid = new Uint8Array(13 * 13).fill(1); // placeholder
computeZoom();
showStart();
requestAnimationFrame(loop);

})();
</script>
</body>
